# Root directory containing one or more ALPR pipeline run folders.
# Example Windows:
# ALPR_OUTPUT_ROOT=D:\Capstone\output
# Example macOS/Linux:
# ALPR_OUTPUT_ROOT=/Users/yourname/Capstone/output
ALPR_OUTPUT_ROOT=

# Optional: point directly at one run. If set and valid, it is included in the selector.
ALPR_RUN_ROOT=

# Auto-discover child run directories under ALPR_OUTPUT_ROOT.
AUTO_DISCOVER_RUNS=true

# Live artifact polling interval. This only re-reads files; it does not modify the ALPR pipeline.
REFRESH_SECONDS=3
